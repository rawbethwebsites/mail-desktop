{
  "name": "mail",
  "version": "0.1.0",
  "description": "Mail",
  "productName": "Mail",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "build": {
    "appId": "local.mail.app",
    "productName": "Mail",
    "files": [
      "**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "pdf-parse": "^2.4.5"
  }
}
